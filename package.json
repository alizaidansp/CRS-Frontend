{
  "name": "crs-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "prepare": "husky",
    "test": "jest --verbose",
    "test:coverage": "jest --coverage",
    "test:failures": "jest --onlyFailures --coverage",
    "test:watch": "jest --watch",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.html\" \"src/**/*.scss\"",
    "format:check": "prettier src --check"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.13",
    "@angular/common": "^18.2.13",
    "@angular/compiler": "^18.2.13",
    "@angular/core": "^18.2.13",
    "@angular/forms": "^18.2.13",
    "@angular/platform-browser": "^18.2.13",
    "@angular/platform-browser-dynamic": "^18.2.13",
    "@angular/router": "^18.2.13",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.1802.19",
    "@angular-devkit/core": "^18.2.19",
    "@angular-devkit/schematics": "^18.2.19",
    "@angular-eslint/eslint-plugin": "^19.6.0",
    "@angular-eslint/eslint-plugin-template": "^19.6.0",
    "@angular-eslint/template-parser": "^19.6.0",
    "@angular/build": "^18.2.19",
    "@angular/cli": "^18.2.19",
    "@angular/compiler-cli": "^18.2.13",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/types": "^7.0.0",
    "angular-eslint": "19.6.0",
    "eslint": "^9.27.0",
    "eslint-plugin-prettier": "^5.4.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.6.0",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.32.1"
  },
  "Resources": {
    "Resolver": {
      "Type": "AWS::AppSync::Resolver",
      "Properties": {
        "TypeName": "<String>",
        "ApiId": "<String>",
        "FieldName": "<String>"
      }
    },
    "FunctionConfiguration": {
      "Type": "AWS::AppSync::FunctionConfiguration",
      "Properties": {
        "Name": "<String>",
        "DataSourceName": "<String>",
        "ApiId": "<String>"
      }
    }
  }
}